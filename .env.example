# ==============================================================================
# SEREIN STOREFRONT ENVIRONMENT CONFIGURATION (.env.example)
# Add these environment variables in your Vercel Project Settings > Environment Variables
# NEVER commit real secret keys or Storefront tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Shopify Storefront Integration (Required for Live / Test Shopify Orders)
# ------------------------------------------------------------------------------
# 1. Your Shopify store domain (from Shopify Admin > Settings > Domains)
SHOPIFY_STORE_DOMAIN=your-store-handle.myshopify.com

# 2. Shopify Storefront API Access Token (Public client token)
# Created in Shopify Admin > Settings > Apps and sales channels > Develop apps > Storefront API
# Permissions required: unauthenticated_read_product_listings, unauthenticated_write_checkouts
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_32_character_storefront_access_token

# 3. Shopify Product Variant ID (Optional - automatically discovered if omitted)
# Found in Shopify Admin > Products > Click your product > Click variant > ID at end of URL
SHOPIFY_VARIANT_ID=

# 4. Shopify Storefront API Version (defaults to 2024-10)
SHOPIFY_API_VERSION=2024-10

# ------------------------------------------------------------------------------
# Optional Secondary Provider: Stripe Checkout
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Store Catalog & Local Dev Settings
# ------------------------------------------------------------------------------
STORE_RETAIL_PRICE=38.00
STORE_INVENTORY=45
STORE_CURRENCY=USD
PORT=3001
