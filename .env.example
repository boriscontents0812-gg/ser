# WAYFOLD Server Environment Configuration
# NEVER commit live keys or expose server keys to browser code

# Stripe payment gateway keys (Keep in test mode until live credentials are confirmed)
STRIPE_SECRET_KEY=sk_test_placeholder_please_configure_in_env
STRIPE_WEBHOOK_SECRET=whsec_placeholder_please_configure_in_env

# Trusted Store Pricing & Inventory (Source of Truth on Server)
# Owner-configured retail price in USD (Never use supplier cost $15.78)
STORE_RETAIL_PRICE=38.00
STORE_INVENTORY=45
STORE_CURRENCY=USD

# Shopify Storefront API Integration (Optional)
# If configured, Shopify becomes the source of truth for products, pricing, and checkout.
# 1. In Shopify Admin -> Apps -> Develop apps -> Create an app
# 2. Configure Storefront API scopes: read_products, unauthenticated_read_product_listings, unauthenticated_write_checkouts
# 3. Paste your domain and Storefront Access Token here:
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_placeholder_storefront_access_token
SHOPIFY_API_VERSION=2024-10
SHOPIFY_PRODUCT_HANDLE=the-double-layer-travel-organizer

# Server port
PORT=3001
